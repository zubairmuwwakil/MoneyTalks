{
  "name": "moneytalks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:with-migrations": "npm run db:migrate:deploy && npm run build",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "e2e": "playwright test",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:env": "node scripts/checks/check-env-documented.mjs",
    "check:exceptions": "node scripts/checks/check-policy-exception-expiry.mjs",
    "check:honesty": "node scripts/checks/check-price-honesty-copy.mjs",
    "check:marketdata": "node scripts/checks/check-no-market-data-provider.mjs",
    "check:cards": "node scripts/checks/check-no-card-rate-model.mjs",
    "check:legacy-subscriptions": "node scripts/checks/check-no-legacy-subscription-writes.mjs",
    "check:keys": "node scripts/checks/check-no-key-leakage.mjs",
    "check:layout": "node scripts/checks/check-repo-layout.mjs",
    "check:tree": "node scripts/checks/check-tree-matches-declared.mjs",
    "check": "npm run check:tree && npm run lint && npm run typecheck && npm run check:env && npm run check:exceptions && npm run check:cards && npm run check:legacy-subscriptions && npm run check:marketdata && npm run check:honesty && npm run check:keys && npm run check:layout && npm run test",
    "qstash:schedules": "node scripts/ops/qstash-schedules.mjs",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "qstash:check": "node scripts/ops/qstash-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@clerk/nextjs": "^7.8.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "^10.72.0",
    "@upstash/qstash": "^2.11.3",
    "@vercel/blob": "^2.8.0",
    "@vercel/otel": "^2.1.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "googleapis": "^174.0.1",
    "imapflow": "^1.7.6",
    "lucide-react": "^1.37.0",
    "luxon": "^3.7.2",
    "mailparser": "^3.9.17",
    "next": "16.3.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.25.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.4.11",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@clerk/backend": "^3.16.13",
    "@clerk/testing": "^2.2.31",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.5",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.13.3",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "fast-check": "^4.9.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.11.0"
}
