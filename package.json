{
  "name": "moneytalks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build",
    "e2e": "playwright test",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:env": "node scripts/checks/check-env-documented.mjs",
    "check:exceptions": "node scripts/checks/check-policy-exception-expiry.mjs",
    "check:honesty": "node scripts/checks/check-price-honesty-copy.mjs",
    "check:marketdata": "node scripts/checks/check-no-market-data-provider.mjs",
    "check:cards": "node scripts/checks/check-no-card-rate-model.mjs",
    "check:keys": "node scripts/checks/check-no-key-leakage.mjs",
    "check:layout": "node scripts/checks/check-repo-layout.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:env && npm run check:exceptions && npm run check:cards && npm run check:marketdata && npm run check:honesty && npm run check:keys && npm run check:layout && npm run test",
    "qstash:schedules": "node scripts/ops/qstash-schedules.mjs",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "qstash:check": "node scripts/ops/qstash-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@clerk/nextjs": "^7.7.6",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nextjs": "^10.70.0",
    "@upstash/qstash": "^2.11.3",
    "@vercel/blob": "^2.8.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "googleapis": "^174.0.1",
    "imapflow": "^1.7.1",
    "lucide-react": "^1.31.0",
    "luxon": "^3.7.2",
    "mailparser": "^3.9.15",
    "next": "16.3.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.20.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.4.11",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
