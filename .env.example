# Copy to .env.local and fill with real values. NEVER commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Optional direct, non-pooled URL used only by Prisma migration commands.
# Leave unset when DATABASE_URL is already a direct Postgres endpoint.
DIRECT_URL=""
# Runtime pool guardrails. Tune from database capacity and observed concurrency.
DATABASE_POOL_MAX="5"
DATABASE_IDLE_TIMEOUT_MS="10000"
DATABASE_CONNECTION_TIMEOUT_MS="5000"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxx"
CLERK_SECRET_KEY="sk_test_xxxxx"
# OPTIONAL kill switch. Unset/empty = registration open to any verified email.
# Set a comma-separated list to close registration and revoke every account
# outside it on its next request.
ALLOWED_EMAILS=""

# Return-SaaS Absorption (Email Ingestion & Automation)
# Encryption keys for stored credentials (OAuth). active version must point to one of the keys.
SECRET_ENC_ACTIVE_VERSION="1"
SECRET_ENC_KEY_V1="base64-encoded-32-byte-key"

# Payments Canada CCIN biller verification. Developer portal credentials are
# product-specific; use the CCIN lookup/extract app's key pair. Sandbox is the
# safe default. Set PAYMENTS_CANADA_ENV=production only after production access.
PAYMENTS_CANADA_CONSUMER_KEY=""
PAYMENTS_CANADA_CONSUMER_SECRET=""
PAYMENTS_CANADA_ENV="sandbox"
# Optional override for a compatible test proxy; defaults to https://api.payments.ca.
PAYMENTS_CANADA_BASE_URL=""

# Gmail API OAuth client credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# REQUIRED. gmailClient.ts non-null-asserts this; if unset, Gmail connect fails
# with an opaque Google error. Must byte-match an Authorized redirect URI on the
# OAuth client in Google Cloud Console.
GOOGLE_REDIRECT_URI="https://your-production-domain.example/api/gmail/callback"

# Resend API key for outbound notifications
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="MoneyTalks <notifications@example.com>"
# Optional: Target email for service and cron failure alerts. Falls back to ALLOWED_EMAILS if unset.
ADMIN_ALERT_EMAIL="admin@example.com"

# Sentry Error Tracking & Performance Monitoring
# Optional: Sentry DSN for client/server error tracking and cron monitoring.
SENTRY_DSN="https://xxxxxxxx@xxxx.ingest.sentry.io/xxxxxx"
NEXT_PUBLIC_SENTRY_DSN="https://xxxxxxxx@xxxx.ingest.sentry.io/xxxxxx"
# Optional: Sentry build/source-map upload credentials
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="moneytalks"
SENTRY_AUTH_TOKEN="sntrys_xxxx"

# Stable multi-instance deployment identity and OpenTelemetry service name.
# DEPLOYMENT_VERSION should be immutable for each production deployment.
DEPLOYMENT_VERSION="local"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
OTEL_SERVICE_NAME="in-unity"
# Optional OTLP exporter settings. Leave blank when the hosting platform
# provides telemetry automatically.
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""

# Used by the QStash schedule setup script to create production callback URLs.
APP_URL="https://your-production-domain.example"
# Host QStash POSTs the cron routes to. Keep SEPARATE from APP_URL: APP_URL
# builds links in user-facing email and follows the consumer brand, while this
# addresses infrastructure and must never move. Falls back to APP_URL if unset.
# Whatever you set must serve /api/cron/* -- an unauthenticated POST should
# return 401/403; a 404/405 means the wrong app, a 3xx means dead jobs.
# Verify with: npx dotenv -e .env.local -- npm run qstash:check
CRON_BASE_URL="https://stable-host.example"

# QStash schedules /api/cron/digest, /api/cron/notify,
# /api/cron/purchase-merge, /api/cron/recurring-sweep, and /api/cron/fx.
# Set the signing keys in Vercel runtime env. QSTASH_TOKEN is only needed where
# you run `npm run qstash:schedules`.
QSTASH_CURRENT_SIGNING_KEY="sig_xxxxx"
QSTASH_NEXT_SIGNING_KEY="sig_xxxxx"
QSTASH_TOKEN="qstash-token"
QSTASH_URL="https://qstash.upstash.io"
QSTASH_DIGEST_CRON="*/15 * * * *"
QSTASH_NOTIFY_CRON="0 * * * *"
QSTASH_PURCHASE_MERGE_CRON="30 3 * * *"
QSTASH_RECURRING_SWEEP_CRON="45 3 * * *"
QSTASH_GMAIL_BACKFILL_CRON="*/5 * * * *"
# Daily FX refresh. Without rates on file, foreign spend cannot accrue to the
# CAD cap ledger at all.
QSTASH_FX_CRON="0 11 * * *"

# Optional manual/external-scheduler fallback for /api/cron/*. Send it as
# x-cron-secret or Authorization: Bearer.
CRON_SECRET="generate-a-long-random-secret"

# Required in production for private receipt attachments. Create a private Blob
# store linked to this Vercel project; local development uses a visible OS tmp fallback when absent.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"

# Card Artwork CDN (Cloudflare R2 custom domain or r2.dev). If unset, falls back to local /cards/*.webp.
NEXT_PUBLIC_CARD_ASSETS_BASE_URL="https://assets.inunity.ca"

# Cloudflare R2 Upload Credentials (for scripts/upload-cards-to-r2.ts)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="moneytalks-cards"

# Comma-separated admin allowlist for /admin/*. UNSET MEANS NOBODY — a deploy that forgets
# this loses the admin pages rather than exposing them.
ADMIN_EMAILS=

# Opens card-request sourcing PRs against PickMe from /admin/card-requests. Unset = the button
# reports that it is unconfigured; it never silently no-ops. Needs contents:write + pull_requests:write.
CATALOGUE_GITHUB_TOKEN=
CATALOGUE_REPO=zubairmuwwakil/PickMe

# Address that receives operational alerts (price staleness, cron failures).
ADMIN_EMAIL=
# From: address on outbound auth and digest mail.
AUTH_EMAIL_FROM=
# Resend API key used for auth and digest mail.
AUTH_RESEND_KEY=
# MarketLens consumer key ("may you call MarketLens"). NOT a provider key —
# provider keys are stored encrypted per user, see src/lib/security/providerKeys.ts.
MARKETLENS_API_KEY=
# Base URL of the MarketLens deployment this hub consumes (E3/E4).
MARKETLENS_BASE_URL=
# QStash region for the scheduled price and FX jobs.
QSTASH_REGION=
