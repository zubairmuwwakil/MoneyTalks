generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---- Auth.js models (shape required by @auth/prisma-adapter) ----
// NOTE: "Account" here is an OAuth/provider account, owned by the adapter.
// Financial accounts (Phase 1) must be modeled as "FinancialAccount".

model User {
  id             String          @id @default(cuid())
  clerkId        String?         @unique
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  accounts       Account[]
  walletInstallations WalletInstallation[]
  walletEvents    WalletEvent[]
  capUsageLedgers CapUsageLedger[]
  capAccruals     CapAccrual[]
  ownerStateRecord OwnerStateRecord?
  cardAliases    CardAlias[]
  sessions       Session[]
  authenticators Authenticator[]
  financialAccounts FinancialAccount[]
  fxRates          FxRate[]
  profile          Profile?
  alerts           Alert[]
  bills            Bill[]
  creditCards      CreditCard[]
  coverageReports  CoverageReport[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  emailConnection        EmailConnection?
  emailTransactions      EmailTransaction[]
  receiptDocuments       ReceiptDocument[]
  purchases              Purchase[]
  returnItems            ReturnItem[]
  shipmentEvents         ShipmentEvent[]
  refundCases            RefundCase[]
  subscriptions          Subscription[]
  subscriptionPayments   SubscriptionPayment[]
  detectedItems          DetectedItem[]
  automationSuggestions  AutomationSuggestion[]
  receiptUploads         ReceiptUpload[]
  notifications          Notification[]
  notificationJobs       NotificationJob[]
  notificationPreference NotificationPreference?
  snoozedEvents          SnoozedEvent[]
  valueEvents            ValueEvent[]
  dataDeletionJobs       DataDeletionJob[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// ---- Financial domain (Phase 1) ----

enum AccountType {
  RRSP
  TFSA
  RDSP
  FHSA
  ROTH_IRA
  NON_REGISTERED
  CASH
  CHEQUING
  CRYPTO
}

enum TxType {
  CONTRIBUTION
  WITHDRAWAL
  BUY
  SELL
  DIVIDEND
  INTEREST
  FEE
}

model FinancialAccount {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         AccountType
  name         String
  institution  String
  country      String // ISO-3166 alpha-2
  currency     String // ISO-4217: CAD | USD | JMD
  isUSSitus    Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  holdings     Holding[]
  transactions Transaction[]
  snapshots    BalanceSnapshot[]

  @@index([userId])
  @@unique([userId, name, institution])
}

model Holding {
  id              String           @id @default(cuid())
  accountId       String
  account         FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol          String
  name            String
  domicileCountry String // ISO-3166 alpha-2 — drives the PFIC scan in Phase 2
  quantity        Decimal
  bookCostMinor   Int?
  lastPriceMinor  Int
  priceAsOf       DateTime

  @@unique([accountId, symbol])
}

model Transaction {
  id          String           @id @default(cuid())
  accountId   String
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        TxType
  amountMinor Int // always positive; TxType determines the sign in derivation
  currency    String
  date        DateTime
  description String?
  dedupeHash  String?

  @@index([accountId, date])
}

model BalanceSnapshot {
  id           String           @id @default(cuid())
  accountId    String
  account      FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  balanceMinor Int
  currency     String
  asOf         DateTime

  @@unique([accountId, asOf])
  @@index([accountId, asOf])
}

model FxRate {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  base   String // ISO-4217
  quote  String // ISO-4217
  rate   Decimal
  asOf   DateTime

  @@unique([userId, base, quote, asOf])
}

// ---- Money Finder (Phase 2) ----

model Profile {
  userId                   String   @id
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  residency                String   @default("CA")
  citizenships             String[] @default([])
  filingStatus             String   @default("SINGLE_ABROAD") // SINGLE_ABROAD | MFJ_ABROAD | OTHER
  marginalUSRatePct        Int      @default(24)
  dtcEligible              Boolean  @default(false)
  benefitPrograms          String[] @default([]) // e.g. ["OW"] or ["ODSP"]
  rdspIncomeTier           String   @default("UNKNOWN") // LOW | HIGH | UNKNOWN
  rdspCarryForwardYears    Int      @default(0)
  rdspGrantsLifetimeMinor  Int      @default(0)
  rdspContribLifetimeMinor Int      @default(0)
  tfsaRoomMinor            Int      @default(0)
  rrspRoomMinor            Int      @default(0)
  fhsaRoomMinor            Int      @default(0)
  cushionMinor             Int      @default(0)
  nhtContributed           Boolean  @default(false)
  incomeSources            Json     @default("[]") // [{name, amountMinor, cadence, kind}]
  updatedAt                DateTime @updatedAt
}

model Alert {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleKey     String
  entityRef   String   @default("") // "" = whole rule; else holdingId/accountId/txId
  dismissedAt DateTime @default(now())

  @@unique([userId, ruleKey, entityRef])
}

// ---- Bills (Phase 3) ----

model Bill {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  category           String // housing | utilities | subscriptions | transport | debt | other
  payee              String?
  sourceAccountId    String? // informational link to a FinancialAccount
  currency           String    @default("CAD")
  autopay            Boolean   @default(false)
  variable           Boolean   @default(false)
  notes              String?
  cadence            Json // {type: BIWEEKLY|MONTHLY|QUARTERLY|ANNUAL, ...} — validated by zod
  schedule           Json // [{from, to?, amountMinor, note?}] — validated by zod
  prepaymentMonthDay String? // "03-15" — enables the mortgage-prepayment reminder rule
  interestRatePct    Decimal? // enables the rough interest-saved estimate
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  payments           Payment[]

  @@unique([userId, name])
}

model Payment {
  id                  String    @id @default(cuid())
  billId              String
  bill                Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  dueDate             DateTime
  expectedAmountMinor Int
  actualAmountMinor   Int?
  paidAt              DateTime?

  @@unique([billId, dueDate])
}

// ---- Cards (Phase 4) ----

model CreditCard {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname       String
  issuer         String
  network        String // VISA | MASTERCARD | AMEX
  lastFour       String?
  country        String     @default("CA")
  currency       String     @default("CAD")
  limitMinor     Int?
  statementDay   Int?
  dueDay         Int?
  aprPct         Decimal?
  annualFeeMinor Int        @default(0)
  // The scoring-contract identity used by Wallet capture aliases. This is
  // intentionally separate from this user's CreditCard.id.
  contractCardId String?
  rewards        Json // validated rewards structure — see src/lib/validation/cards.ts
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  state          CardState?
  coverageReports CoverageReport[]

  @@unique([userId, nickname])
  @@index([userId, contractCardId])
}

// A compact, durable result of an in-memory statement reconciliation. Raw
// statement lines are deliberately never retained after the upload response.
model CoverageReport {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId         String
  card           CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  month          String     // transaction month: YYYY-MM
  matchedLines   Int
  eligibleLines  Int
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([cardId, month])
  @@index([userId, cardId, month])
}

model CardState {
  cardId               String     @id
  card                 CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  capsUsage            Json       @default("[]") // [{category, periodKey, usedMinor}]
  creditsRedeemed      Json       @default("[]") // [{creditId, periodKey}]
  rewardsEstimateMinor Int        @default(0) // owner's estimate of rewards earned this year
  updatedAt            DateTime   @updatedAt
}

// ---- Return SaaS Absorbed Models ----

enum SubscriptionCadence {
  MONTHLY
  YEARLY
  CUSTOM
}

enum DetectedItemType {
  TRIAL
  RENEWAL
  BILL
}

enum DetectedItemStatus {
  NEW
  CONFIRMED
  DISMISSED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

enum ReturnStatus {
  NOT_STARTED
  PACKED
  DROPPED_OFF
  DELIVERED
  REFUNDED
}

enum ValueEventType {
  AVOIDED_RENEWAL
  REFUND_RECEIVED
  FEE_AVOIDED
}

model Subscription {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  amountCents Int
  currency    String              @default("CAD")
  renewalDate DateTime
  cadence     SubscriptionCadence @default(MONTHLY)
  status      SubscriptionStatus  @default(ACTIVE)
  cancelUrl   String?
  notes       String?
  trialEndAt  DateTime?
  cancelInstructions String?
  merchantCanonicalId String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  detectedItems DetectedItem[]

  @@index([userId, renewalDate])
}

model ReturnItem {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseId       String?
  store            String
  itemNote         String?
  amountCents      Int?
  currency         String       @default("CAD")
  purchaseDate     DateTime
  returnWindowDays Int          @default(30)
  returnBy         DateTime
  status           ReturnStatus @default(NOT_STARTED)

  trackingNumber    String?
  carrier           String?
  dropoffDate       DateTime? 
  deliveredAt       DateTime?
  refundExpectedAt  DateTime? 
  refundedDate      DateTime? 
  refundAmountCents Int? 
  refundSlaDays     Int       @default(14)
  refundType        String?   @default("ORIGINAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipmentEvents ShipmentEvent[] @relation("ReturnItemShipmentEvents")
  refundCase     RefundCase?     @relation("ReturnItemRefundCase")
  purchase       Purchase?       @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([userId, returnBy])
  @@index([userId, refundExpectedAt]) 
}

enum EmailProvider {
  GMAIL
  UPLOAD
}

enum PurchaseSource {
  WALLET
  GMAIL
  UPLOAD
  MANUAL
}

enum ScanMode {
  ALL
  RECEIPTS_ONLY
  SHIPPING_ONLY
  SUBSCRIPTIONS_ONLY
}

enum DataDeletionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model SnoozedEvent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId      String
  snoozedUntil DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId])
  @@index([userId, snoozedUntil])
}

enum ReceiptUploadStatus {
  PARSED
  NEEDS_REVIEW
  FAILED
}

model ReceiptUpload {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  filename    String
  contentType String
  sizeBytes   Int
  storagePath String

  status    ReceiptUploadStatus @default(NEEDS_REVIEW)
  extracted Json?
  error     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model Purchase {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant      String
  totalCents    Int?
  currency      String         @default("CAD")
  purchasedAt   DateTime
  orderNumber   String?
  paymentMethod String?
  // Canonical checkout category once the source has been resolved. A null
  // category remains deliberately unresolved rather than being guessed.
  category      String?
  source        PurchaseSource @default(GMAIL)
  sourceEmailId String?
  sourceEventId String?
  // Conservative near-match (amount+time matched, merchant unclear). Plain
  // column, no FK — the flagged row must survive its counterpart's deletion.
  possibleDuplicateOfId String?

  items       PurchaseItem[]
  attachments PurchaseAttachment[]
  returns     ReturnItem[]
  walletEvents      WalletEvent[]
  emailTransactions EmailTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, purchasedAt])
  @@index([userId, merchant])
  @@unique([userId, sourceEmailId])
  @@unique([userId, sourceEventId])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  title       String
  qty         Int?
  priceCents  Int?
  currency    String  @default("CAD")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

model PurchaseAttachment {
  id            String   @id @default(cuid())
  purchaseId    String
  storageKey    String
  mime          String?
  sha256        String?
  sourceEmailId String?
  sourceEventId String?

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([purchaseId])
  @@unique([purchaseId, storageKey])
}

enum SuggestionStatus {
  NEW
  CONFIRMED
  IGNORED
}

enum SuggestionType {
  RETURN
  SUBSCRIPTION
  BILL
}

model EmailConnection {
  id       String        @id @default(cuid())
  userId   String        @unique
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider EmailProvider @default(GMAIL)

  emailAddress String?
  accessToken  String?
  refreshToken String?
  expiry       DateTime?
  scope        String?
  lastScanAt   DateTime?
  scanMode     ScanMode     @default(ALL)
  imapUser     String?
  imapPassword String?
  imapHost     String?
  imapPort     Int?
  imapSecure   Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DataDeletionJob {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedAt DateTime           @default(now())
  status      DataDeletionStatus @default(PENDING)
  completedAt DateTime?
  error       String?

  @@index([userId, status])
}

model AutomationSuggestion {
  id       String        @id @default(cuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider EmailProvider @default(GMAIL)

  primaryMessageId String? 

  type   SuggestionType
  status SuggestionStatus @default(NEW)

  merchant     String
  amountCents  Int?
  currency     String   @default("CAD")
  detectedDate DateTime

  confidence String
  reasons    Json
  messageIds Json
  draft      Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, primaryMessageId])
  @@index([userId, status])
  @@index([userId, type])
}

model DetectedItem {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          DetectedItemType
  merchant      String
  amountCents   Int?
  currency      String             @default("CAD")
  date          DateTime
  confidence    String
  sourceEmailId String?
  sourceEventId String?
  rawSnippetHash String
  status        DetectedItemStatus @default(NEW)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, date])
  @@index([userId, merchant])
}

model EmailTransaction {
  id       String        @id @default(cuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider EmailProvider @default(GMAIL)

  messageId String
  merchant  String
  fromEmail String?
  subject   String?

  purchasedAt DateTime?
  orderId     String?
  totalCents  Int?
  currency    String    @default("CAD")
  items       Json?
  rawSource   String
  parserError String?

  receiptDocuments ReceiptDocument[]

  // Canonical purchase this observation fed (set at scan promotion).
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([userId, provider, messageId])
  @@index([purchaseId])
  @@index([userId, merchant])
  @@index([userId, purchasedAt])
}

model ReceiptDocument {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailTransactionId String
  emailTransaction   EmailTransaction @relation(fields: [emailTransactionId], references: [id], onDelete: Cascade)

  filename    String
  contentType String
  storagePath String 
  sizeBytes   Int

  createdAt DateTime @default(now())

  @@index([userId, emailTransactionId])
}

model SubscriptionPayment {
  id             String @id @default(cuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String

  paidAt      DateTime
  amountCents Int
  currency    String   @default("CAD")
  notes       String?

  createdAt DateTime @default(now())

  @@index([userId, subscriptionId, paidAt])
}

enum NotificationType {
  SUBSCRIPTION_RENEWAL_SOON
  RETURN_DEADLINE_SOON
  BILL_DUE_SOON
  REFUND_CHECK_DUE
  REFUND_OVERDUE
  RETURN_DELIVERED
}

enum NotificationChannel {
  EMAIL_DIGEST
  EMAIL_IMMEDIATE
}

enum NotificationJobStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELED
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String?

  eventDate DateTime?

  scheduledFor DateTime

  sourceKind String
  sourceId   String

  eventKey String

  readAt      DateTime?
  dismissedAt DateTime?
  emailedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs NotificationJob[]

  @@unique([userId, eventKey])
  @@index([userId, scheduledFor])
  @@index([userId, readAt])
  @@index([userId, dismissedAt])
}

model NotificationJob {
  id      String                @id @default(cuid())
  userId  String
  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel NotificationChannel
  status  NotificationJobStatus @default(PENDING)

  sendAt    DateTime 
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime?

  lockedAt DateTime?
  lockId   String? 

  notificationId String?
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  dedupeKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dedupeKey])
  @@index([status, sendAt])
  @@index([userId, sendAt])
}

model NotificationPreference {
  userId             String  @id
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailDigestEnabled Boolean @default(false)
  timezone           String  @default("America/Toronto")
  digestHourLocal    Int     @default(9) 
  windowDays         Int     @default(14)
  subLeadDays        Int     @default(3)
  returnLeadDays     Int     @default(2)
  billLeadDays       Int     @default(2)
  primaryEmail       String?
  notifyOnDelivery   Boolean @default(true)
  notifyOnRefundOverdue Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShipmentEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  returnId   String
  statusCode String
  statusText String
  occurredAt DateTime
  location   String?
  raw        Json?
  createdAt  DateTime @default(now())

  returnItem ReturnItem @relation("ReturnItemShipmentEvents", fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId, occurredAt])
  @@index([userId, occurredAt])
}

model RefundCase {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  returnId          String   @unique
  expectedAt        DateTime?
  receivedAt        DateTime?
  overdueNotifiedAt DateTime?
  refundType        String?  @default("ORIGINAL")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  returnItem ReturnItem @relation("ReturnItemRefundCase", fields: [returnId], references: [id], onDelete: Cascade)
}

model ValueEvent {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       ValueEventType
  amountCents Int
  currency   String         @default("CAD")
  occurredAt DateTime
  sourceId   String?
  isEstimated Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, occurredAt])
  @@index([userId, type])
}

model WalletInstallation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  label     String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  walletEvents WalletEvent[]

  @@index([userId])
}

enum WalletEventProcessingStatus {
  OBSERVED
  NORMALIZED
  POSSIBLE_DUPLICATE
  RECONCILED
  REVERSED
}

model WalletEvent {
  id                     String                      @id @default(cuid())
  userId                 String
  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletInstallationId   String
  walletInstallation     WalletInstallation          @relation(fields: [walletInstallationId], references: [id], onDelete: Cascade)
  eventId                String                      @unique
  source                 String
  schemaVersion          Int
  shortcutVersion        Int
  capturedAt             DateTime
  // The device's original timestamp string (offset preserved) and IANA zone —
  // capturedAt alone can't reproduce the wall-clock time the user experienced.
  capturedAtRaw          String?
  capturedTimezone       String?
  uploadedAt             DateTime                    @default(now())

  merchantRaw            String?
  transactionNameRaw     String?
  amountRaw              Decimal?                    @db.Decimal(15, 4)
  currencyRaw            String?
  cardRaw                String?
  merchantNormalized     String?
  resolvedCardId         String?

  latitude               Float?
  longitude              Float?
  locationAccuracyMeters Float?

  // Payload as received, before any server interpretation. Lets improved
  // parsers re-read history and preserves fields the server didn't understand.
  rawPayload             Json?

  assumedCurrency        Boolean                     @default(false)

  // The synchronous capture verdict is retained so the iOS feedback log can show
  // what the server actually returned at tap time. Raw event fields remain immutable.
  feedbackVerdict        String?
  feedbackWarning        String?

  processingStatus       WalletEventProcessingStatus @default(OBSERVED)

  // Canonical purchase this observation fed (set at normalization).
  purchaseId             String?
  purchase               Purchase?                   @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([userId, eventId])
  @@index([userId, capturedAt])
  @@index([purchaseId])
}

model MerchantAlias {
  id             String   @id @default(cuid())
  rawString      String   @unique
  normalizedName String
  // Optional because aliases can be resolved before a category is known.
  category       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Per-user: the same raw device string ("RBC Visa") can mean different
// physical cards for different users. MerchantAlias stays global on purpose —
// merchant identity is universal, shared learning benefits everyone.
model CardAlias {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawString String
  cardId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, rawString])
}

model OwnerStateRecord {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stateData Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Materialized cap use for the active card-contract window. Amounts are minor
// units of the cap's measure (CAD cents or USD-equivalent cents).
model CapUsageLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  capId     String
  periodKey String
  usedMinor Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, cardId, capId, periodKey])
  @@index([userId, capId, periodKey])
}

// One row per source event gives cap updates exactly-once semantics and retains
// the delta required to reverse a WalletEvent after it has been normalized.
model CapAccrual {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceKey     String   @unique
  cardId        String
  capId         String
  periodKey     String
  usedMinor     Int
  reversedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, cardId, capId, periodKey])
}
