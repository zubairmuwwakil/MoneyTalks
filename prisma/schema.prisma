generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                          String                       @id @default(cuid())
  name                        String?
  email                       String?                      @unique
  emailVerified               DateTime?
  image                       String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  clerkId                     String?                      @unique
  accounts                    Account[]
  alerts                      Alert[]
  authenticators              Authenticator[]
  automationSuggestions       AutomationSuggestion[]
  bills                       Bill[]
  capAccruals                 CapAccrual[]
  capUsageLedgers             CapUsageLedger[]
  cardAliases                 CardAlias[]
  cardRequests                CardRequest[]
  coverageReports             CoverageReport[]
  creditCards                 CreditCard[]
  dataDeletionJobs            DataDeletionJob[]
  detectedItems               DetectedItem[]
  emailConnection             EmailConnection?
  emailTransactions           EmailTransaction[]
  financialAccounts           FinancialAccount[]
  fxRates                     FxRate[]
  notifications               Notification[]
  notificationJobs            NotificationJob[]
  notificationPreference      NotificationPreference?
  ownerStateRecord            OwnerStateRecord?
  profile                     Profile?
  providerCredentials         ProviderCredential[]
  purchases                   Purchase[]
  purchaseDuplicateDismissals PurchaseDuplicateDismissal[]
  receiptDocuments            ReceiptDocument[]
  receiptUploads              ReceiptUpload[]
  refundCases                 RefundCase[]
  returnItems                 ReturnItem[]
  sessions                    Session[]
  shipmentEvents              ShipmentEvent[]
  snoozedEvents               SnoozedEvent[]
  statementLines              StatementLine[]
  subscriptions               Subscription[]
  subscriptionPayments        SubscriptionPayment[]
  valueEvents                 ValueEvent[]
  walletEvents                WalletEvent[]
  walletInstallations         WalletInstallation[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model FinancialAccount {
  id           String            @id @default(cuid())
  userId       String
  type         AccountType
  name         String
  institution  String
  country      String
  currency     String
  isUSSitus    Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  snapshots    BalanceSnapshot[]
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings     Holding[]
  transactions Transaction[]

  @@unique([userId, name, institution])
  @@index([userId])
}

model Holding {
  id              String           @id @default(cuid())
  accountId       String
  symbol          String
  name            String
  domicileCountry String
  quantity        Decimal
  bookCostMinor   Int?
  lastPriceMinor  Int
  priceAsOf       DateTime
  priceCurrency   String?
  priceSource     String?
  priceStatus     String?
  account         FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, symbol])
}

/// A user's own upstream market-data credential (BYOK).
///
/// Stored here, encrypted, and never in MarketLens: MarketLens is a stateless
/// shared provider and holding user credentials is exactly the personal-finance
/// territory it is not allowed to grow into. The key is decrypted only to be put
/// on a single outbound request header, and MarketLens uses it and forgets it.
model ProviderCredential {
  id           String    @id @default(cuid())
  userId       String
  /// Provider source name as MarketLens knows it, e.g. ALPHAVANTAGE.
  provider     String
  /// AES-256-GCM envelope from secretCrypto — never a plaintext key.
  encryptedKey String
  label        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastUsedAt   DateTime?
  /// Outcome the last time this key actually served a request (USER, or the
  /// reason it did not), so a silently-dead key is visible instead of looking
  /// like everything is fine while Yahoo quietly serves everything.
  lastStatus   String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model Transaction {
  id          String           @id @default(cuid())
  accountId   String
  type        TxType
  amountMinor Int
  currency    String
  date        DateTime
  description String?
  dedupeHash  String?
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
}

model BalanceSnapshot {
  id           String           @id @default(cuid())
  accountId    String
  balanceMinor Int
  currency     String
  asOf         DateTime
  account      FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, asOf])
  @@index([accountId, asOf])
}

model FxRate {
  id     String   @id @default(cuid())
  userId String
  base   String
  quote  String
  rate   Decimal
  asOf   DateTime
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, base, quote, asOf])
}

model Profile {
  userId                   String   @id
  residency                String   @default("CA")
  citizenships             String[] @default([])
  filingStatus             String   @default("SINGLE_ABROAD")
  marginalUSRatePct        Int      @default(24)
  dtcEligible              Boolean  @default(false)
  benefitPrograms          String[] @default([])
  rdspIncomeTier           String   @default("UNKNOWN")
  rdspCarryForwardYears    Int      @default(0)
  rdspGrantsLifetimeMinor  Int      @default(0)
  rdspContribLifetimeMinor Int      @default(0)
  tfsaRoomMinor            Int      @default(0)
  rrspRoomMinor            Int      @default(0)
  fhsaRoomMinor            Int      @default(0)
  nhtContributed           Boolean  @default(false)
  incomeSources            Json     @default("[]")
  updatedAt                DateTime @updatedAt
  cushionMinor             Int      @default(0)
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Alert {
  id          String   @id @default(cuid())
  userId      String
  ruleKey     String
  entityRef   String   @default("")
  dismissedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ruleKey, entityRef])
}

model Bill {
  id                 String      @id @default(cuid())
  userId             String
  name               String
  category           String
  payee              String?
  sourceAccountId    String?
  currency           String      @default("CAD")
  autopay            Boolean     @default(false)
  variable           Boolean     @default(false)
  notes              String?
  cadence            Json
  schedule           Json
  prepaymentMonthDay String?
  interestRatePct    Decimal?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  spendCategory      String?
  paymentCardId      String?
  paymentRail        String      @default("unknown")
  railFeePct         Decimal?
  paymentCard        CreditCard? @relation(fields: [paymentCardId], references: [id])
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments           Payment[]

  @@unique([userId, name])
  @@index([paymentCardId])
}

model Payment {
  id                  String    @id @default(cuid())
  billId              String
  dueDate             DateTime
  expectedAmountMinor Int
  actualAmountMinor   Int?
  paidAt              DateTime?
  bill                Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, dueDate])
}

model CreditCard {
  id                 String           @id @default(cuid())
  userId             String
  nickname           String
  issuer             String
  network            String
  lastFour           String?
  country            String           @default("CA")
  currency           String           @default("CAD")
  limitMinor         Int?
  statementDay       Int?
  dueDay             Int?
  aprPct             Decimal?
  annualFeeMinor     Int              @default(0)
  // What the owner's own banking package actually rebates off the fee. This is
  // the OWNER's arrangement, not a property of the card, which is why it lives
  // here and not in the catalogue: issuers offer tiers (Scotia's Ultimate can
  // rebate up to $150 where Preferred rebates $40), so only the owner can say
  // which one they hold. The catalogue's `fee.waiver` prose is shown alongside
  // as guidance; no figure is ever inferred from it.
  feeRebateMinor     Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  contractCardId     String?
  feeMonthDay        String?
  feeCancelGraceDays Int              @default(30)
  bills              Bill[]
  state              CardState?
  coverageReports    CoverageReport[]
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  statementLines     StatementLine[]

  @@unique([userId, nickname])
  @@index([userId, contractCardId])
}

model StatementLine {
  id            String     @id @default(cuid())
  userId        String
  cardId        String
  date          DateTime
  description   String
  amountMinor   Int
  status        String
  purchaseId    String?
  walletEventId String?
  lineHash      String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  card          CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  purchase      Purchase?  @relation(fields: [purchaseId], references: [id])
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lineHash])
  @@index([userId, date])
  @@index([purchaseId])
}

model CoverageReport {
  id            String     @id @default(cuid())
  userId        String
  cardId        String
  month         String
  matchedLines  Int
  eligibleLines Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  card          CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, month])
  @@index([userId, cardId, month])
}

model CardState {
  cardId               String     @id
  capsUsage            Json       @default("[]")
  creditsRedeemed      Json       @default("[]")
  rewardsEstimateMinor Int        @default(0)
  updatedAt            DateTime   @updatedAt
  card                 CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                  String              @id @default(cuid())
  userId              String
  name                String
  amountCents         Int
  currency            String              @default("CAD")
  renewalDate         DateTime
  cadence             SubscriptionCadence @default(MONTHLY)
  status              SubscriptionStatus  @default(ACTIVE)
  cancelUrl           String?
  notes               String?
  trialEndAt          DateTime?
  cancelInstructions  String?
  merchantCanonicalId String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  detectedItems       DetectedItem[]
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, renewalDate])
}

model ReturnItem {
  id                String          @id @default(cuid())
  userId            String
  purchaseId        String?
  store             String
  itemNote          String?
  amountCents       Int?
  currency          String?
  purchaseDate      DateTime
  returnWindowDays  Int             @default(30)
  returnBy          DateTime
  status            ReturnStatus    @default(NOT_STARTED)
  trackingNumber    String?
  carrier           String?
  dropoffDate       DateTime?
  deliveredAt       DateTime?
  refundExpectedAt  DateTime?
  refundedDate      DateTime?
  refundAmountCents Int?
  refundSlaDays     Int             @default(14)
  refundType        String?         @default("ORIGINAL")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  refundCase        RefundCase?     @relation("ReturnItemRefundCase")
  purchase          Purchase?       @relation(fields: [purchaseId], references: [id])
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipmentEvents    ShipmentEvent[] @relation("ReturnItemShipmentEvents")

  @@index([userId, returnBy])
  @@index([userId, refundExpectedAt])
}

model SnoozedEvent {
  id           String   @id @default(cuid())
  userId       String
  eventId      String
  snoozedUntil DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId, snoozedUntil])
}

model ReceiptUpload {
  id          String              @id @default(cuid())
  userId      String
  filename    String
  contentType String
  sizeBytes   Int
  storagePath String
  status      ReceiptUploadStatus @default(NEEDS_REVIEW)
  extracted   Json?
  error       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Purchase {
  id                        String                       @id @default(cuid())
  userId                    String
  merchant                  String
  totalCents                Int?
  currency                  String?
  purchasedAt               DateTime
  orderNumber               String?
  paymentMethod             String?
  source                    PurchaseSource               @default(GMAIL)
  sourceEmailId             String?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  category                  String?
  possibleDuplicateOfId     String?
  sourceEventId             String?
  emailTransactions         EmailTransaction[]
  user                      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments               PurchaseAttachment[]
  duplicateDismissalsAsHigh PurchaseDuplicateDismissal[] @relation("DuplicateDismissalHigh")
  duplicateDismissalsAsLow  PurchaseDuplicateDismissal[] @relation("DuplicateDismissalLow")
  items                     PurchaseItem[]
  returns                   ReturnItem[]
  statementLines            StatementLine[]
  walletEvents              WalletEvent[]

  @@unique([userId, sourceEmailId])
  @@unique([userId, sourceEventId])
  @@index([userId, purchasedAt])
  @@index([purchasedAt])
  @@index([userId, merchant])
}

model PurchaseDuplicateDismissal {
  id             String   @id @default(cuid())
  userId         String
  purchaseLowId  String
  purchaseHighId String
  dismissedAt    DateTime @default(now())
  purchaseHigh   Purchase @relation("DuplicateDismissalHigh", fields: [purchaseHighId], references: [id], onDelete: Cascade)
  purchaseLow    Purchase @relation("DuplicateDismissalLow", fields: [purchaseLowId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purchaseLowId, purchaseHighId])
  @@index([purchaseLowId])
  @@index([purchaseHighId])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  title      String
  qty        Int?
  priceCents Int?
  currency   String?
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

model PurchaseAttachment {
  id            String   @id @default(cuid())
  purchaseId    String
  storageKey    String
  mime          String?
  sha256        String?
  sourceEmailId String?
  createdAt     DateTime @default(now())
  sourceEventId String?
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@unique([purchaseId, storageKey])
  @@index([purchaseId])
}

model EmailConnection {
  id           String        @id @default(cuid())
  userId       String        @unique
  provider     EmailProvider @default(GMAIL)
  emailAddress String?
  accessToken  String?
  refreshToken String?
  expiry       DateTime?
  scope        String?
  lastScanAt   DateTime?
  scanMode     ScanMode      @default(ALL)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DataDeletionJob {
  id          String             @id @default(cuid())
  userId      String
  requestedAt DateTime           @default(now())
  status      DataDeletionStatus @default(PENDING)
  completedAt DateTime?
  error       String?
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model AutomationSuggestion {
  id               String           @id @default(cuid())
  userId           String
  provider         EmailProvider    @default(GMAIL)
  primaryMessageId String?
  type             SuggestionType
  status           SuggestionStatus @default(NEW)
  merchant         String
  amountCents      Int?
  currency         String?
  detectedDate     DateTime
  confidence       String
  reasons          Json
  messageIds       Json
  draft            Json
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, primaryMessageId])
  @@index([userId, status])
  @@index([userId, type])
}

model DetectedItem {
  id             String             @id @default(cuid())
  userId         String
  type           DetectedItemType
  merchant       String
  amountCents    Int?
  currency       String?
  date           DateTime
  confidence     String
  sourceEmailId  String?
  rawSnippetHash String
  status         DetectedItemStatus @default(NEW)
  subscriptionId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  sourceEventId  String?
  subscription   Subscription?      @relation(fields: [subscriptionId], references: [id])
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, date])
  @@index([userId, merchant])
}

model EmailTransaction {
  id               String            @id @default(cuid())
  userId           String
  provider         EmailProvider     @default(GMAIL)
  messageId        String
  merchant         String
  fromEmail        String?
  subject          String?
  purchasedAt      DateTime?
  orderId          String?
  totalCents       Int?
  currency         String?
  items            Json?
  rawSource        String
  parserError      String?
  createdAt        DateTime          @default(now())
  purchaseId       String?
  purchase         Purchase?         @relation(fields: [purchaseId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiptDocuments ReceiptDocument[]

  @@unique([userId, provider, messageId])
  @@index([purchaseId])
  @@index([userId, merchant])
  @@index([userId, purchasedAt])
}

model ReceiptDocument {
  id                 String           @id @default(cuid())
  userId             String
  emailTransactionId String
  filename           String
  contentType        String
  storagePath        String
  sizeBytes          Int
  createdAt          DateTime         @default(now())
  emailTransaction   EmailTransaction @relation(fields: [emailTransactionId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, emailTransactionId])
}

model SubscriptionPayment {
  id             String   @id @default(cuid())
  userId         String
  subscriptionId String
  paidAt         DateTime
  amountCents    Int
  currency       String   @default("CAD")
  notes          String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subscriptionId, paidAt])
}

model Notification {
  id           String            @id @default(cuid())
  userId       String
  type         NotificationType
  title        String
  body         String?
  eventDate    DateTime?
  scheduledFor DateTime
  sourceKind   String
  sourceId     String
  eventKey     String
  readAt       DateTime?
  dismissedAt  DateTime?
  emailedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs         NotificationJob[]

  @@unique([userId, eventKey])
  @@index([userId, scheduledFor])
  @@index([userId, readAt])
  @@index([userId, dismissedAt])
}

model NotificationJob {
  id             String                @id @default(cuid())
  userId         String
  channel        NotificationChannel
  status         NotificationJobStatus @default(PENDING)
  sendAt         DateTime
  attempts       Int                   @default(0)
  lastError      String?
  sentAt         DateTime?
  lockedAt       DateTime?
  lockId         String?
  notificationId String?
  dedupeKey      String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  notification   Notification?         @relation(fields: [notificationId], references: [id])
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([status, sendAt])
  @@index([userId, sendAt])
}

model NotificationPreference {
  userId                String   @id
  emailDigestEnabled    Boolean  @default(false)
  timezone              String   @default("America/Toronto")
  digestHourLocal       Int      @default(9)
  windowDays            Int      @default(14)
  subLeadDays           Int      @default(3)
  returnLeadDays        Int      @default(2)
  billLeadDays          Int      @default(2)
  primaryEmail          String?
  notifyOnDelivery      Boolean  @default(true)
  notifyOnRefundOverdue Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShipmentEvent {
  id         String     @id @default(cuid())
  userId     String
  returnId   String
  statusCode String
  statusText String
  occurredAt DateTime
  location   String?
  raw        Json?
  createdAt  DateTime   @default(now())
  returnItem ReturnItem @relation("ReturnItemShipmentEvents", fields: [returnId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([returnId, occurredAt])
  @@index([userId, occurredAt])
}

model RefundCase {
  id                String     @id @default(cuid())
  userId            String
  returnId          String     @unique
  expectedAt        DateTime?
  receivedAt        DateTime?
  overdueNotifiedAt DateTime?
  refundType        String?    @default("ORIGINAL")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  returnItem        ReturnItem @relation("ReturnItemRefundCase", fields: [returnId], references: [id], onDelete: Cascade)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ValueEvent {
  id          String         @id @default(cuid())
  userId      String
  type        ValueEventType
  amountCents Int
  currency    String         @default("CAD")
  occurredAt  DateTime
  sourceId    String?
  isEstimated Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, type])
}

model WalletInstallation {
  id           String        @id @default(cuid())
  userId       String
  tokenHash    String        @unique
  label        String
  createdAt    DateTime      @default(now())
  revokedAt    DateTime?
  walletEvents WalletEvent[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WalletEvent {
  id                     String                      @id @default(cuid())
  userId                 String
  walletInstallationId   String
  eventId                String                      @unique
  source                 String
  schemaVersion          Int
  shortcutVersion        Int
  capturedAt             DateTime
  uploadedAt             DateTime                    @default(now())
  merchantRaw            String?
  transactionNameRaw     String?
  amountRaw              Decimal?                    @db.Decimal(15, 4)
  currencyRaw            String?
  cardRaw                String?
  latitude               Float?
  longitude              Float?
  locationAccuracyMeters Float?
  assumedCurrency        Boolean                     @default(false)
  processingStatus       WalletEventProcessingStatus @default(OBSERVED)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  feedbackVerdict        String?
  feedbackWarning        String?
  capturedAtRaw          String?
  capturedTimezone       String?
  merchantNormalized     String?
  resolvedCardId         String?
  rawPayload             Json?
  purchaseId             String?
  purchase               Purchase?                   @relation(fields: [purchaseId], references: [id])
  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletInstallation     WalletInstallation          @relation(fields: [walletInstallationId], references: [id], onDelete: Cascade)

  @@index([userId, eventId])
  @@index([userId, capturedAt])
  @@index([purchaseId])
}

model MerchantAlias {
  id             String   @id @default(cuid())
  rawString      String   @unique
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  category       String?
}

model CardAlias {
  id        String   @id @default(cuid())
  rawString String
  cardId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rawString])
}

model OwnerStateRecord {
  id        String   @id @default(cuid())
  userId    String   @unique
  stateData Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CapUsageLedger {
  id        String   @id @default(cuid())
  userId    String
  cardId    String
  capId     String
  periodKey String
  usedMinor Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, capId, periodKey])
  @@index([userId, capId, periodKey])
}

model CapAccrual {
  id                String    @id @default(cuid())
  userId            String
  sourceKey         String    @unique
  cardId            String
  capId             String
  periodKey         String
  usedMinor         Int
  reversedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sourceAmountMinor Int?
  sourceCurrency    String?
  fxRate            Decimal?
  fxRateAsOf        DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, cardId, capId, periodKey])
}

model Waitlist {
  id        String    @id @default(cuid())
  email     String    @unique
  createdAt DateTime  @default(now())
  invitedAt DateTime?
}

model CardRequest {
  id        String   @id @default(cuid())
  userId    String
  issuer    String
  cardName  String
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

