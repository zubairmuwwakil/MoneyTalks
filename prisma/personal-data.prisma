enum PersonalInventoryEventType {
  PURCHASED
  OPENED
  FINISHED
  ADJUSTMENT
  RETURNED
  DISCARDED
}

enum PersonalInventoryEventSource {
  NOTION
  MANUAL
  BUTTON
  AI
  API
  IMPORT
}

enum PersonalNotionEntityType {
  NEED
  PRODUCT
  EVENT
}

enum PersonalInventoryOutboxTopic {
  SYNC_PRODUCT_TO_NOTION
  CREATE_EVENT_IN_NOTION
}

enum PersonalInventoryOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model PersonalInventoryNeed {
  id              String   @id @default(cuid())
  ownerKey        String   @default("primary")
  stableId        String
  name            String
  aisle           String?
  active          Boolean  @default(true)
  backupTarget    Int      @default(1)
  reorderPoint    Int?
  defaultRetailer String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products PersonalInventoryProduct[]
  events   PersonalInventoryEvent[]

  @@unique([ownerKey, stableId])
  @@index([ownerKey, active])
  @@map("personal_inventory_needs")
}

model PersonalInventoryProduct {
  id                  String   @id @default(cuid())
  ownerKey            String   @default("primary")
  stableId            String
  name                String
  brand               String?
  careArea            String?
  active              Boolean  @default(true)
  backupUnits         Int      @default(0)
  inUse               Boolean  @default(false)
  openedAt            DateTime?
  repurchase          String?
  needsIdentification Boolean  @default(false)
  notes               String?
  needId              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  need   PersonalInventoryNeed?  @relation(fields: [needId], references: [id], onDelete: SetNull)
  events PersonalInventoryEvent[]

  @@unique([ownerKey, stableId])
  @@index([ownerKey, active])
  @@index([needId])
  @@map("personal_inventory_products")
}

model PersonalInventoryEvent {
  id            String                       @id @default(cuid())
  ownerKey      String                       @default("primary")
  externalKey   String
  type          PersonalInventoryEventType
  quantityDelta Int
  occurredAt    DateTime
  source        PersonalInventoryEventSource @default(API)
  notes         String?
  productId     String?
  needId        String?
  createdAt     DateTime                     @default(now())

  product PersonalInventoryProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  need    PersonalInventoryNeed?    @relation(fields: [needId], references: [id], onDelete: SetNull)

  @@unique([ownerKey, externalKey])
  @@index([ownerKey, occurredAt])
  @@index([productId, occurredAt])
  @@index([needId, occurredAt])
  @@map("personal_inventory_events")
}

model PersonalNotionEntityMap {
  id           String                   @id @default(cuid())
  ownerKey     String                   @default("primary")
  entityType   PersonalNotionEntityType
  stableId     String
  pageId       String                   @unique
  dataSourceId String
  lastEditedAt DateTime?
  lastSyncedAt DateTime                 @default(now())
  deletedAt    DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([ownerKey, entityType, stableId])
  @@index([ownerKey, dataSourceId])
  @@map("personal_notion_entity_maps")
}

model PersonalNotionWebhookReceipt {
  id              String   @id
  ownerKey        String   @default("primary")
  eventType       String
  entityId        String?
  entityType      String?
  attemptNumber   Int      @default(1)
  notionTimestamp DateTime?
  payload         Json
  processedAt     DateTime?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerKey, processedAt])
  @@map("personal_notion_webhook_receipts")
}

model PersonalNotionSubscription {
  ownerKey                    String   @id
  verificationTokenEncrypted  String
  workspaceId                 String?
  integrationId               String?
  subscriptionId              String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("personal_notion_subscriptions")
}

model PersonalInventoryOutbox {
  id          String                         @id @default(cuid())
  ownerKey    String                         @default("primary")
  topic       PersonalInventoryOutboxTopic
  dedupeKey   String                         @unique
  aggregateId String
  payload     Json
  status      PersonalInventoryOutboxStatus  @default(PENDING)
  attempts    Int                            @default(0)
  availableAt DateTime                       @default(now())
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt

  @@index([ownerKey, status, availableAt])
  @@map("personal_inventory_outbox")
}
