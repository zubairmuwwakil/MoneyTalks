{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pickme.local/contracts/engine-fixtures.schema.json",
  "title": "PickMe engine fixtures",
  "description": "Documents the shape of engine-fixtures.json exactly as decoded by the private FixtureFile/FixtureCase types in Engine/Tests/CardCopilotEngineTests/FixtureHarnessTests.swift (spec §4/§5). As with card-catalogue.schema.json, \"x-status\": \"documentation-only\" marks fields present in the JSON with no matching Swift property — silently dropped on decode, human-facing only. There are more of these here than in the catalogue: the fixture format leans on prose (description, notes) that the test harness never reads back, because the assertions are the spec, not the prose. Fixtures 1.1 added four expectation fields plus per-case `asOf` and `unsetFields`, because three of spec §5's rule families — effective-dating boundaries, the announced-FX record, and the valuation-disclosure gate — could not be expressed at all in 1.0.",
  "type": "object",
  "required": [
    "creditCases",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "fixturesVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "x-status": "documentation-only",
      "description": "Mirrors card-catalogue.json's catalogueVersion convention (MAJOR.MINOR) for future non-Swift consumers, but FixtureFile does not decode this key today, so nothing in Engine validates it — unlike catalogueVersion, which SeedLoader enforces."
    },
    "_note": {
      "type": "string",
      "x-status": "documentation-only",
      "description": "Global prose context (pinned valuations, base owner state). FixtureFile has no matching property."
    },
    "pinnedValuations": {
      "$ref": "#/$defs/pinnedValuations"
    },
    "creditCases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/creditFixtureCase"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fixtureCase"
      }
    }
  },
  "$defs": {
    "creditFixtureCase": {
      "type": "object",
      "required": ["caseId", "asOf", "cardId", "credit", "cardState", "expected"],
      "additionalProperties": false,
      "properties": {
        "caseId": { "type": "string" },
        "asOf": { "type": "string", "format": "date" },
        "cardId": { "type": "string" },
        "credit": { "$ref": "#/$defs/fixtureCardCredit" },
        "cardState": { "$ref": "#/$defs/creditCardState" },
        "purchase": { "$ref": "#/$defs/purchaseContext" },
        "expected": { "$ref": "#/$defs/creditExpected" }
      }
    },
    "fixtureCardCredit": {
      "type": "object",
      "required": ["creditId", "label", "value", "schedule", "sourceType", "lastVerifiedAt"],
      "additionalProperties": false,
      "properties": {
        "creditId": { "type": "string" },
        "label": { "type": "string" },
        "value": {
          "type": "object",
          "required": ["amount", "currency"],
          "additionalProperties": false,
          "properties": {
            "amount": { "type": "number", "minimum": 0 },
            "currency": { "type": "string" }
          }
        },
        "schedule": {
          "type": "object",
          "required": ["basis"],
          "additionalProperties": false,
          "properties": {
            "basis": { "enum": ["calendar", "accountAnniversary", "rolling"] },
            "unit": { "enum": ["month", "quarter", "halfYear", "year"] },
            "interval": { "type": "integer", "minimum": 1 },
            "intervalMonths": { "type": "integer", "minimum": 1 },
            "resetTimeZone": { "type": "string" }
          }
        },
        "redemptionMethod": {
          "enum": ["statementCredit", "portalCredit", "accountCredit", "reimbursement"]
        },
        "purchasePredicate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "categories": { "type": "array", "items": { "type": "string" } },
            "mccInclude": { "type": "array", "items": { "type": "integer" } },
            "mccExclude": { "type": "array", "items": { "type": "integer" } },
            "merchantInclude": { "type": "array", "items": { "type": "string" } },
            "merchantExclude": { "type": "array", "items": { "type": "string" } },
            "country": { "type": "string" },
            "currency": { "type": "string" },
            "channels": { "type": "array", "items": { "type": "string" } }
          }
        },
        "allowsPartialUse": { "type": "boolean" },
        "enrollment": {
          "type": "object",
          "required": ["required"],
          "additionalProperties": false,
          "properties": {
            "required": { "type": "boolean" },
            "channel": { "enum": ["issuerPortal", "issuerApp", "partnerAccount", "phone"] },
            "url": { "type": "string", "format": "uri" }
          }
        },
        "effectiveFrom": { "type": "string", "format": "date" },
        "effectiveTo": { "type": "string", "format": "date" },
        "sourceType": { "enum": ["issuerConfirmed", "inferred"] },
        "lastVerifiedAt": { "type": "string", "format": "date" },
        "sources": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        }
      }
    },
    "creditCardState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accountOpenedAt": { "type": "string", "format": "date" },
        "creditStates": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enrollmentStatus": {
                "enum": ["unknown", "enrolled", "notEnrolled", "notRequired"]
              },
              "windows": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": ["updatedAt"],
                  "additionalProperties": false,
                  "properties": {
                    "consumedAmount": { "type": "number", "minimum": 0 },
                    "realizedAmount": { "type": "number", "minimum": 0 },
                    "updatedAt": { "type": "string", "format": "date" }
                  }
                }
              },
              "lastRedemptionAt": { "type": "string", "format": "date" }
            }
          }
        }
      }
    },
    "creditExpected": {
      "type": "object",
      "required": ["windowId", "remainingAmount", "realizedAmount", "status"],
      "additionalProperties": false,
      "properties": {
        "windowId": { "type": "string" },
        "expiresOn": { "type": "string", "format": "date" },
        "nextEligibleOn": { "type": "string", "format": "date" },
        "remainingAmount": { "type": "number", "minimum": 0 },
        "realizedAmount": { "type": "number", "minimum": 0 },
        "status": {
          "enum": ["available", "used", "needsEnrollment", "notYetEligible", "scheduleUnresolved"]
        },
        "daysRemaining": { "type": "integer", "minimum": 0 },
        "checkoutCreditId": { "type": "string" },
        "checkoutCreditValueCad": { "type": "number", "minimum": 0 }
      }
    },
    "pinnedValuations": {
      "type": "object",
      "required": [
        "amexMembershipRewards"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "amexMembershipRewards": {
          "type": "number",
          "description": "Overrides OwnerState.valuationsCad.amexMembershipRewards.centsPerPoint for the whole fixture run — deliberately pinned above the cash floor so cases exercise points-vs-cash ranking rather than tracking owner-state.json's live (lower) setting."
        },
        "_why": {
          "type": "string",
          "x-status": "documentation-only",
          "description": "PinnedValuations decodes only amexMembershipRewards; this key is dropped."
        }
      }
    },
    "fixtureCase": {
      "type": "object",
      "required": [
        "caseId",
        "purchase",
        "expected"
      ],
      "additionalProperties": false,
      "properties": {
        "caseId": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "x-status": "documentation-only",
          "description": "FixtureCase has no `description` property — dropped silently on decode. Purely for a human reading the file."
        },
        "purchase": {
          "$ref": "#/$defs/purchaseContext"
        },
        "asOf": {
          "type": "string",
          "format": "date",
          "description": "Evaluation date passed to RecommendationEngine.recommend. Defaults to 2026-08-20 (the suite-wide date) when omitted. Compared lexicographically against effectiveFrom/effectiveTo on both earn rules and FX records, so it is the only way to exercise date-boundary behaviour."
        },
        "ownerStateOverrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cardStates": {
              "type": "object",
              "description": "Keyed by cardId. Values merge onto the base owner-state.json CardState (spec: capProgress merges key-by-key; every other field replaces outright) — see FixtureHarnessTests' merge loop.",
              "additionalProperties": {
                "$ref": "#/$defs/cardStateOverride"
              }
            }
          }
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    },
    "purchaseContext": {
      "type": "object",
      "description": "Decoded directly into the real engine type PurchaseContext (Models/PurchaseContext.swift) — every field here is genuinely consumed, not just documentation.",
      "required": [
        "amountCad",
        "category"
      ],
      "additionalProperties": false,
      "properties": {
        "amountCad": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "default": "CAD",
          "examples": [
            "CAD",
            "USD"
          ]
        },
        "usdEquivalent": {
          "type": "number",
          "description": "Only consulted for a spendUsdEquivalent cap (currently just Crypto.com); Scorer falls back to amountCad * 0.73 when omitted."
        },
        "category": {
          "type": "string"
        },
        "mcc": {
          "type": [
            "integer",
            "null"
          ]
        },
        "merchantBrand": {
          "type": [
            "string",
            "null"
          ]
        },
        "country": {
          "type": "string",
          "default": "CA"
        },
        "channel": {
          "type": "string",
          "default": "cardPresent",
          "examples": [
            "cardPresent",
            "online",
            "amexTravel"
          ]
        },
        "recurringIndicator": {
          "type": "boolean",
          "default": false
        },
        "acceptedNetworks": {
          "type": "array",
          "items": {
            "enum": [
              "amex",
              "visa",
              "mastercard"
            ]
          },
          "default": [
            "amex",
            "visa",
            "mastercard"
          ]
        }
      }
    },
    "cardStateOverride": {
      "type": "object",
      "description": "Decoded as the real engine CardState type (Models/OwnerState.swift) — every field genuinely consumed, all optional; a nil field means unresolved (RuleMatcher skips rules that depend on it rather than guessing). `unsetFields` is the escape hatch: merging can only ever SET a field, but nil (unresolved) is a distinct input and owner-state.json resolves most conditions to false rather than leaving them nil.",
      "additionalProperties": false,
      "properties": {
        "capProgress": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "scotiaAccountYearAnchorMonth": {
          "type": "integer"
        },
        "selectedCategories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "treatAsAllSelected": {
          "type": "boolean"
        },
        "thirdCategoryUnlocked": {
          "type": "boolean"
        },
        "nextChangeEffectiveDate": {
          "type": "string",
          "format": "date"
        },
        "rogersEligibleServiceLinked": {
          "type": "boolean"
        },
        "rogersAccountAnniversaryMonth": {
          "type": "integer"
        },
        "feeWaiverActive": {
          "type": "boolean"
        },
        "cryptoLevelUpProActive": {
          "type": "boolean"
        },
        "croHandling": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "autoSell",
            "hold",
            null
          ]
        },
        "flags": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Owner-condition answers keyed by the catalogue's ownerConditions id, merged over the base state's flags. Keys are unconstrained on purpose: the closed list lives in owner-conditions.json, and duplicating it here would make declaring a condition a two-file edit again. An absent key is unresolved and fails closed; false is a real answer meaning no."
        },
        "unsetFields": {
          "type": "array",
          "items": {
            "enum": [
              "capProgress",
              "cryptoLevelUpProActive",
              "croHandling",
              "rogersEligibleServiceLinked",
              "selectedCategories",
              "treatAsAllSelected"
            ]
          },
          "description": "Fields forced back to nil AFTER the merge. An unknown entry fails the test rather than being ignored."
        }
      }
    },
    "expected": {
      "type": "object",
      "required": [
        "winner",
        "winnerValueCad"
      ],
      "additionalProperties": false,
      "properties": {
        "winner": {
          "type": "string",
          "description": "cardId of RecommendationEngine's winner."
        },
        "winnerValueCad": {
          "type": "number",
          "description": "Asserted with accuracy 0.005."
        },
        "winnerRule": {
          "type": "string"
        },
        "runnerUp": {
          "type": [
            "string",
            "null"
          ]
        },
        "runnerUpValueCad": {
          "type": "number"
        },
        "switchFromDefault": {
          "type": "boolean"
        },
        "advantageOverDefaultCad": {
          "type": "number"
        },
        "defaultNotAccepted": {
          "type": "boolean"
        },
        "suppressedBetterCard": {
          "type": "string",
          "description": "A card that would win on raw value but the switch threshold ('both' or 'either' semantics, spec §5) holds the default instead."
        },
        "suppressedValueCad": {
          "type": "number"
        },
        "warnings": {
          "type": "array",
          "items": {
            "enum": [
              "drawerCard",
              "unresolvedOwnerState",
              "networkNotAccepted",
              "capNearlyExhausted",
              "negativeNetValue",
              "fxAllowanceAssumed",
              "hypotheticalSelection"
            ]
          },
          "description": "Checked as a subset (every listed warning must appear in the winner's actual warnings) — Warning enum raw values."
        },
        "notes": {
          "type": "string",
          "x-status": "documentation-only",
          "description": "Hand-derived arithmetic proving winnerValueCad by hand (spec §5's 'never tune the expectation to the engine' discipline). Expected struct has no `notes` property — the proof lives in the file for human review, not in the assertion. Required in practice for every case added from 1.1 onward."
        },
        "warningsAbsent": {
          "type": "array",
          "items": {
            "enum": [
              "drawerCard",
              "unresolvedOwnerState",
              "networkNotAccepted",
              "capNearlyExhausted",
              "negativeNetValue",
              "fxAllowanceAssumed",
              "hypotheticalSelection"
            ]
          },
          "description": "Warnings that must NOT appear on the winner. The only way to pin behaviour whose entire signal is a warning — e.g. Crypto's two FX records are both rate 0, so ignoring the announced one before its effectiveFrom is dollar-identical and observable only through fxAllowanceAssumed."
        },
        "cardScores": {
          "type": "array",
          "description": "Optional assertions against named entries in Recommendation.allCandidates. This covers card-local semantics that cannot truthfully be forced into the overall winner (for example a plural-only capped base rule below the wallet's default rate).",
          "items": {
            "type": "object",
            "required": [
              "cardId",
              "valueCad"
            ],
            "additionalProperties": false,
            "properties": {
              "cardId": {
                "type": "string"
              },
              "valueCad": {
                "type": "number",
                "description": "CandidateScore.netValueCad, asserted with accuracy 0.005."
              },
              "rule": {
                "type": "string",
                "description": "CandidateScore.appliedRuleId."
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Warnings that must appear on the named candidate."
              },
              "warningsAbsent": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Warnings that must not appear on the named candidate."
              }
            }
          }
        },
        "valuationSensitive": {
          "type": "boolean",
          "description": "Recommendation.valuationSensitive — whether the advice turns on the declared point valuation."
        },
        "valuationDirection": {
          "enum": [
            "below",
            "above"
          ],
          "description": "Recommendation.valuationDirection, compared by its Swift case name. 'below' = the winner is a points card that only wins above the cash floor; 'above' = a points card would overtake if points were worth more. Downside is checked first, so at most one direction is ever disclosed."
        },
        "alternateWinner": {
          "type": "string",
          "description": "Recommendation.alternateWinnerCardId — the card that wins on the other side of the breakeven."
        },
        "breakevenCentsPerPoint": {
          "type": "number",
          "description": "Recommendation.breakevenCentsPerPoint, asserted with accuracy 0.005. Includes the switch threshold against the default card, so it is the cents-per-point at which the ADVICE flips, not merely where raw values cross."
        }
      }
    }
  }
}
